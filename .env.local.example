# Environment variables for CANDELA
# Copy to .env.local and fill in values

# Perplexity API Key (required for fact-checking)
# Get yours at: https://docs.perplexity.ai/
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxx

# Vercel KV (auto-populated when you link KV in Vercel dashboard)
# Not needed for local development
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Memory Server (optional, for saving reports)
# Only accessible from Tailscale network
# MEMORY_SERVER_URL=http://100.114.216.76:3003
